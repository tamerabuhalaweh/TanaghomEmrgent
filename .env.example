# Copy this file to your deployment secret manager or local .env.
# Do not commit real values.

MONGO_URL=mongodb://mongo:27017
DB_NAME=tanaghum
JWT_SECRET=<generate-a-long-random-secret>

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=<generate-with-fernet>

# Comma-separated explicit origins. Wildcard "*" is intentionally rejected.
CORS_ORIGINS=https://your-frontend-domain.example,http://localhost:3000

# Optional. Required only when using universal LLM generation.
UNIVERSAL_LLM_KEY=
EMERGENT_LLM_KEY=

# GHL read sync remains disabled until a tenant has credentials and operations approves API reads.
GHL_READ_SYNC_ENABLED=false
